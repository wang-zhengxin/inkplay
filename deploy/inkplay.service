[Unit]
Description=Inkplay text platform game
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
RuntimeDirectory=inkplay
ExecStartPre=/usr/sbin/nginx -t -c /etc/inkplay/nginx.conf
ExecStart=/usr/sbin/nginx -c /etc/inkplay/nginx.conf -g "daemon off;"
ExecReload=/bin/kill -HUP $MAINPID
KillSignal=SIGQUIT
TimeoutStopSec=10
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
